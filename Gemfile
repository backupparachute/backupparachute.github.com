source "https://rubygems.org"

gem "jekyll", "~> 4.3"

# Pin to sass-converter 2.x (libsass) to avoid sass-embedded native binary
# issues under linux/amd64 emulation on Apple Silicon.
gem "jekyll-sass-converter", "~> 2.2"

group :jekyll_plugins do
  gem "jekyll-sitemap"
  gem "jekyll-redirect-from"
  gem "jekyll-seo-tag"
end

gem "webrick", "~> 1.8"
